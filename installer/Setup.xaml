<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lunarix Setup" Width="820" Height="520" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#0A0A0A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="28,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="14" Background="#FFFFFF" Opacity="0" Margin="-5">
                <Border.Effect>
                  <BlurEffect Radius="18"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="BorderBrush" Value="#333333"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A4A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#8C8C8C"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="4,6">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1F1F1F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D6D6D6"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Border x:Name="Box" CornerRadius="5" BorderBrush="#4A4A4A" BorderThickness="1.5" Background="Transparent"/>
                <Path x:Name="Tick" Data="M4.5,9.2 L7.8,12.3 L13.6,5.8" Stroke="#0A0A0A" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF"/>
                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#9A9A9A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="Background" Value="#121212"/>
      <Setter Property="BorderBrush" Value="#2E2E2E"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#808080"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#8C8C8C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Border CornerRadius="20" Background="#0A0A0A" BorderBrush="#242424" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border x:Name="Clip" CornerRadius="20" Background="#0A0A0A" BorderBrush="#242424" BorderThickness="1">
      <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="Stars" IsHitTestVisible="False"/>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-170,0,0,0" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#1CFFFFFF" Offset="0"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <Grid Width="320" HorizontalAlignment="Left">
          <Viewbox x:Name="LogoBox" Width="176" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="LogoFloat" Y="0"/>
              </TransformGroup>
            </Viewbox.RenderTransform>
            <Canvas Width="512" Height="512">
              <Rectangle Canvas.Left="8" Canvas.Top="8" Width="496" Height="496" RadiusX="116" RadiusY="116" Stroke="#1AFFFFFF" StrokeThickness="1">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1D1D1D" Offset="0"/>
                    <GradientStop Color="#050505" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Ellipse Canvas.Left="46" Canvas.Top="46" Width="420" Height="420">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#29FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Path>
                <Path.Data>
                  <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                      <EllipseGeometry Center="252,266" RadiusX="150" RadiusY="150"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                      <EllipseGeometry Center="322,204" RadiusX="128" RadiusY="128"/>
                    </CombinedGeometry.Geometry2>
                  </CombinedGeometry>
                </Path.Data>
                <Path.Fill>
                  <LinearGradientBrush StartPoint="0.1,0.05" EndPoint="0.85,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#D4D4D4" Offset="0.55"/>
                    <GradientStop Color="#6F6F6F" Offset="1"/>
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <Rectangle x:Name="Caret" Canvas.Left="306" Canvas.Top="170" Width="30" Height="156" RadiusX="15" RadiusY="15" Fill="#FFFFFF"/>
            </Canvas>
          </Viewbox>
        </Grid>

        <Grid x:Name="Pages" Margin="320,58,52,46">
          <StackPanel x:Name="PageWelcome" VerticalAlignment="Center">
            <TextBlock x:Name="TTitle" Text="Lunarix" FontSize="44" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="TSub" TextWrapping="Wrap" FontSize="14.5" Foreground="#9C9C9C" Margin="0,8,0,0" LineHeight="23"/>
            <StackPanel x:Name="Options" Visibility="Collapsed" Margin="0,22,0,0">
              <TextBlock x:Name="TLoc" Foreground="#8C8C8C" FontSize="12"/>
              <Grid Margin="0,7,0,0">
                <TextBox x:Name="PathBox" Style="{StaticResource Input}" Margin="0,0,104,0"/>
                <Button x:Name="BrowseBtn" Style="{StaticResource Ghost}" Height="40" Width="96" Padding="0" HorizontalAlignment="Right"/>
              </Grid>
              <CheckBox x:Name="DesktopCb" IsChecked="True" Margin="0,16,0,0"/>
              <CheckBox x:Name="LaunchCb" IsChecked="True" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
              <Button x:Name="InstallBtn" Style="{StaticResource Primary}"/>
              <Button x:Name="OptionsBtn" Style="{StaticResource Link}" Margin="18,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TLegal" Foreground="#555555" FontSize="11.5" Margin="0,24,0,0" TextWrapping="Wrap" LineHeight="17"/>
          </StackPanel>

          <StackPanel x:Name="PageProgress" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="PTitle" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="PStatus" Foreground="#8C8C8C" FontSize="13" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="BarTrack" Margin="0,28,0,0" Height="6" ClipToBounds="True">
              <Border CornerRadius="3" Background="#1F1F1F"/>
              <Border x:Name="Bar" CornerRadius="3" Background="#FFFFFF" HorizontalAlignment="Left" Width="0"/>
              <Border x:Name="Shine" Width="90" HorizontalAlignment="Left" CornerRadius="3" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <TranslateTransform x:Name="ShineX" X="-100"/>
                </Border.RenderTransform>
              </Border>
            </Grid>
            <Grid Margin="0,12,0,0">
              <TextBlock x:Name="PPercent" FontSize="13" Foreground="#D0D0D0" FontFamily="Cascadia Mono, Consolas"/>
              <TextBlock x:Name="PDetail" FontSize="12" Foreground="#5E5E5E" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid Width="58" Height="58" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
              </Grid.RenderTransform>
              <Ellipse Fill="#FFFFFF"/>
              <Path Data="M17,30 L25,38 L42,20" Stroke="#0A0A0A" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <TextBlock x:Name="DTitle" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,24,0,0"/>
            <TextBlock x:Name="DSub" TextWrapping="Wrap" FontSize="14" Foreground="#9C9C9C" Margin="0,8,0,0" LineHeight="22"/>
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
              <Button x:Name="LaunchBtn" Style="{StaticResource Primary}"/>
              <Button x:Name="FinishBtn" Style="{StaticResource Ghost}" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="PageUninstall" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="UTitle" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="USub" TextWrapping="Wrap" FontSize="14" Foreground="#9C9C9C" Margin="0,8,0,0" LineHeight="22"/>
            <CheckBox x:Name="RemoveDataCb" Margin="0,22,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
              <Button x:Name="UninstallBtn" Style="{StaticResource Primary}"/>
              <Button x:Name="CancelBtn" Style="{StaticResource Ghost}" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="PageError" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="ETitle" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="EText" TextWrapping="Wrap" FontSize="13" Foreground="#9C9C9C" Margin="0,10,0,0" LineHeight="20"/>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
              <Button x:Name="RetryBtn" Style="{StaticResource Primary}"/>
              <Button x:Name="ErrCloseBtn" Style="{StaticResource Ghost}" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid x:Name="TitleBar" Height="48" VerticalAlignment="Top" Background="Transparent">
          <TextBlock x:Name="WinTitle" Foreground="#5C5C5C" FontSize="12" Margin="24,16,0,0" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,12,0" VerticalAlignment="Top">
            <Button x:Name="MinBtn" Style="{StaticResource WinBtn}">
              <Path Data="M0,0 L10,0" Stroke="#9A9A9A" StrokeThickness="1.3" Margin="0,6,0,0"/>
            </Button>
            <Button x:Name="CloseBtn" Style="{StaticResource WinBtn}" Margin="4,0,0,0">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#9A9A9A" StrokeThickness="1.3"/>
            </Button>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="VersionText" Foreground="#3A3A3A" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,18"/>
      </Grid>
    </Border>
  </Grid>
</Window>
